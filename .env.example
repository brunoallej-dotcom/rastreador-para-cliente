# Copie para .env.local e preencha. NUNCA commite valores reais.
# Todas as variáveis são lidas só no servidor (sem prefixo NEXT_PUBLIC_) e validadas
# por Zod no boot (src/shared/config/env.ts): o app não sobe se faltar alguma.
# Spec: docs/specs/client-delivery-tracker.md §3.11

# Origem pública do app, usada na checagem de Origin (CSRF).
# Formato: https://<seu-dominio> (em dev: http://localhost:3000)
APP_ORIGIN=

# Supabase: Project Settings → API Keys. Em dev local, `pnpm db:status` mostra os valores.
# Use o projeto de DEV/STAGING localmente; nunca o de produção.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Secret key: IGNORA RLS. Lida só em src/shared/db/admin-client.ts e scripts/.
SUPABASE_SECRET_KEY=

# Chave HMAC das chaves de rate limit (o banco não guarda IP nem e-mail em claro).
# Gere com: openssl rand -base64 32
RATE_LIMIT_KEY_SECRET=

# Nível de log do pino: trace | debug | info | warn | error
LOG_LEVEL=info
